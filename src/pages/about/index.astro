---
import Base from "../../layout/Base.astro";
import * as About from "./content.md";
const { Content } = About;
---

<Base
    title="About - The CS Compendium"
    className="min-h-screen w-screen flex flex-col gap-8 justify-center items-center px-6 py-10"
>
    <h1
        class="text-primary-fgt font-departure text-5xl md:text-6xl font-bold text-center"
    >
        The Chronicle of the Compendium
    </h1>

    <div
        class="w-full max-w-3xl rounded-3xl border border-primary-fgt/20 bg-primary-bg/80 px-6 py-8 font-departure text-primary-fgo shadow-sm backdrop-blur-sm md:px-10 md:py-10"
    >
        <article class="markdown-content space-y-5 text-left text-base leading-8 md:text-lg">
            <Content />
        </article>
    </div>
</Base>
